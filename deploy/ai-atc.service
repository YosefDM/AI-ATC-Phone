[Unit]
Description=AI ATC phone line
After=network-online.target
Wants=network-online.target

[Service]
User=aiatc
Group=aiatc
WorkingDirectory=/opt/ai-atc-phone
EnvironmentFile=/opt/ai-atc-phone/.env
ExecStart=/opt/ai-atc-phone/.venv/bin/uvicorn atc.server:app --host 127.0.0.1 --port 8090 --workers 1 --no-access-log
Restart=always
RestartSec=3
# keep it from starving SMSPilot on a shared droplet
MemoryMax=750M
CPUWeight=80
Nice=2

[Install]
WantedBy=multi-user.target
