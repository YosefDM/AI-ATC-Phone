# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
# Twilio: Account SID + Auth Token are used to verify webhook signatures
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Public HTTPS base URL that Twilio calls, e.g. https://atc.smspilot.app
PUBLIC_BASE_URL=
# Comma-separated E.164 numbers allowed to call
ALLOWED_CALLERS=+18453769892,+18455871172
# Random secret for stream tokens (generate with: openssl rand -hex 32)
APP_SECRET=

# Deepgram: streaming speech recognition + Aura-2 voices (without it: OpenAI STT + local voices)
DEEPGRAM_API_KEY=
# Live speech recognition while he talks: assemblyai (best in testing) | openai | elevenlabs | deepgram
STT_PROVIDER=assemblyai
ASSEMBLYAI_API_KEY=
# Protects /admin (call transcripts and recordings). Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Optional tuning
CHATTER=auto
MAX_GUESTS=25
RECORD_CALLS=1
HOME_AIRPORT=KEWR
LLM_MODEL=gpt-5.4-mini-2026-03-17
LLM_FALLBACK_MODEL=gpt-4.1-mini-2025-04-14
LLM_REASONING_EFFORT=none
STT_MODEL=gpt-transcribe
PTT_KEY=1
ATIS_KEY=9
SILENCE_STOP_S=2.0
RESUME_WINDOW_MIN=120
